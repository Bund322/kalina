---
import { contacts, phoneHref, routeHref } from '../data/studio';
import Socials from './Socials.astro';
---
<section class="contact orn" id="book">
  <div class="wrap" style="position:relative">
    <div class="label rv">Запись</div>
    <h2 class="rv">Приходите на сеанс</h2>
    <div class="c-grid">
      <div class="rv">
        <p style="max-width:32ch;margin:0 0 24px">Ждём вас на тату и пирсинг. Напишите нам свою идею – ответим в течение дня.</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn solid" href={contacts.telegram} target="_blank" rel="noopener">Написать в Telegram</a>
          <a class="btn" href={phoneHref}>Позвонить</a>
        </div>
        <Socials />
      </div>
      <dl class="rv">
        <div><dt>Адрес</dt><dd>{contacts.address}</dd></div>
        <div><dt>Часы работы</dt><dd>{contacts.hours}</dd></div>
        <div><dt>Телефон</dt><dd><a href={phoneHref}>{contacts.phone}</a></dd></div>
      </dl>
    </div>
    <div class="c-map rv">
      <iframe src={contacts.map} title="Студия «Калина» на карте" loading="lazy" allowfullscreen></iframe>
      <a href={routeHref} target="_blank" rel="noopener">Как добраться – открыть в Яндекс Картах</a>
    </div>
  </div>
</section>
