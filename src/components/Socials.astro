---
import { socials } from '../data/studio';

// Иконки соцсетей рисуются currentColor — цвет задаёт окружение (блок записи, подвал).
const icons: Record<string, string> = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>',
  telegram: '<path fill="currentColor" d="M21.4 3.6 2.9 10.7c-1.3.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.4.8.9.8.4 0 .6-.2.9-.5l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.9-1.4-1.4ZM9.3 13.6l9.3-5.9c.4-.3.8-.1.5.2l-7.6 6.9-.3 3.2-1.9-4.4Z"/>',
  vk: '<path fill="currentColor" d="M12.8 17.5c-5.5 0-8.6-3.8-8.8-10h2.8c.1 4.6 2.1 6.5 3.7 6.9V7.5h2.6v3.9c1.6-.2 3.3-2 3.8-3.9h2.6c-.4 2.4-2.2 4.2-3.4 4.9 1.2.6 3.2 2.1 4 5.1h-2.9c-.6-2-2.2-3.5-4.1-3.7v3.7h-.3Z"/>',
};
---
<ul class="socials">
  {socials.map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.id]} />
      </a>
    </li>
  ))}
</ul>
