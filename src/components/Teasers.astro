---
import { Image } from 'astro:assets';
import head from '../assets/teasers/head.png';
import body from '../assets/teasers/body.png';
import practice from '../assets/education/practice.jpg';
import { url } from '../data/url';

// Статичные кадры 3D-моделей — главная остаётся лёгкой, живая сцена грузится только на своей странице.
// Кадры снимаются со сцен в dev-режиме (см. CLAUDE.md, раздел «Тизеры»).
const cards = [
  { href: url('/piercing'), img: head, label: '3D-модель головы', title: 'Выбрать прокол', text: 'Покрутите голову, нажмите на точку — расскажем о проколе, цене и заживлении.' },
  { href: url('/tattoo'), img: body, label: 'Карта боли', title: 'Где больно бить тату', text: 'Нажмите на зону тела и узнайте, насколько там больно и как подготовиться к сеансу.' },
  { href: url('/education'), img: practice, photo: true, label: 'Обучение', title: 'Стать мастером', text: 'Курсы тату и пирсинга с практикой на моделях, дипломом и возможностью работать в студии.' },
];
---
<section class="teasers" id="interactive">
  <div class="wrap">
    <div class="sec-head rv"><div><div class="label">Разделы</div><h2>Узнать больше</h2></div></div>
    <div class="ts-grid">
      {cards.map((c) => (
        <a class="ts-card rv" href={c.href}>
          <span class:list={['ts-ph', { photo: c.photo }]}><Image src={c.img} alt="" widths={[400, 800]} sizes="(max-width: 800px) 90vw, 30vw" /></span>
          <span class="label">{c.label}</span>
          <span class="ts-title">{c.title}</span>
          <span class="ts-text">{c.text}</span>
          <span class="ts-more">Открыть →</span>
        </a>
      ))}
    </div>
  </div>
</section>
