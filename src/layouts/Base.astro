---
// Шрифты лежат на самом сайте (пакеты @fontsource), без запросов к Google: быстрее и не зависит от внешнего сервиса.
import '@fontsource/oranienbaum/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/golos-text/400.css';
import '@fontsource/golos-text/500.css';
import '@fontsource/golos-text/600.css';
import '../styles/global.css';
import BerrySymbol from '../components/BerrySymbol.astro';
import Preloader from '../components/Preloader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../data/url';

interface Props {
  title?: string;
  description?: string;
  /** Прелоадер с ягодой – только на главной: анимация заголовка hero ждёт его ухода. */
  preloader?: boolean;
}
const {
  title,
  description = 'Татуировки и пирсинг в спокойной студии. Эскиз обсуждаем лично, работаем стерильно и без спешки.',
  preloader = false,
} = Astro.props;
const fullTitle = title ? `${title} – Калина` : 'Калина Tattoo Studio';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="only light" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  </head>
  <body>
    <BerrySymbol />
    {preloader && <Preloader />}
    <div class="cur" id="cur"></div>
    <Header />
    <main id="top">
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/ui';</script>
  </body>
</html>
