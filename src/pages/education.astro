---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import { Image } from 'astro:assets';
import photo from '../assets/education/practice.jpg';
import edu from '../data/education.json';
import { contacts } from '../data/studio';
---
<Base title="Обучение" description="Курсы тату и пирсинга в студии «Калина»: теория, практика на моделях, диплом и возможность работать в студии.">
  <section class="edu">
    <div class="wrap two">
      <div class="rv edu-intro">
        <div class="label">Обучение</div>
        <h2>Научим бить тату и делать проколы</h2>
        <p>Теория, отработка на искусственной коже и практика на живых моделях под присмотром мастера. Учим в рабочей студии – на тех же стерильных стандартах, что и на сеансах.</p>
        <p class="edu-outcome">{edu.outcome}</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn solid" href={contacts.telegram} target="_blank" rel="noopener">Записаться на курс</a>
        </div>
      </div>
      <div class="rv edu-ph">
        <Image src={photo} alt="Мастер набивает цветную татуировку" widths={[480, 960]} sizes="(max-width: 860px) 100vw, 45vw" />
      </div>
    </div>
  </section>

  <section class="edu-courses">
    <div class="wrap">
      <div class="sec-head rv"><div><div class="label">Программы</div><h2>Курсы</h2></div></div>
      <div class="course-grid">
        {edu.courses.map((c) => (
          <article class="course rv">
            <h3>{c.title}</h3>
            <div class="course-price">{c.price}</div>
            <ul>{c.program.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="edu-models">
    <div class="wrap two">
      <div class="rv">
        <div class="label">Для моделей</div>
        <h3 class="sub-h">Стать моделью</h3>
        <p style="max-width:40ch;margin:0 0 20px">Ученики отрабатывают практику на моделях под контролем мастера – это возможность сделать тату или прокол дешевле.</p>
        <a class="btn" href={edu.models.channel} target="_blank" rel="noopener">Канал с моделями</a>
      </div>
      <div class="rv">
        <ul class="price">
          {edu.models.prices.map((p) => (
            <li><span class="n">{p.name}</span><span class="dots"></span><span class="p">{p.price}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Contact />
</Base>
