---
import Base from '../layouts/Base.astro';
import PriceList from '../components/PriceList.astro';
import Contact from '../components/Contact.astro';
import Teasers from '../components/Teasers.astro';
import { url } from '../data/url';
import { piercingPriceNote } from '../data/studio';
import { Image } from 'astro:assets';
import { masters, directionLabel, gallery, workCategories } from '../data/masters';
import edu from '../data/education.json';

const works = gallery();
// Цены для моделей – те же, что на странице обучения: «тату от 800 ₽, пирсинг от 600 ₽».
const modelPrices = edu.models.prices.map((m) => `${m.name.toLowerCase()} ${m.price}`).join(', ');

const letters = [...'Калина'];
const words = ['Тату', 'Пирсинг', 'Эскизы', 'Ботаника', 'Орнамент', 'Титан', 'Стерильно'];
// Четыре копии, чтобы лента не обрывалась при сдвиге на -50%.
const marquee = [...words, ...words, ...words, ...words];
---
<Base preloader>
  <div class="hero" id="hero">
    <svg class="berry-float bf1" data-k="22" viewBox="0 0 640 640"><use href="#berry"/></svg>
    <svg class="berry-float bf2" data-k="-30" viewBox="0 0 640 640" style="transform:rotate(18deg)"><use href="#berry"/></svg>
    <div class="wrap">
      <h1 aria-label="Калина">{letters.map((l, i) => <span style={`--i:${i}`}>{l}</span>)}</h1>
      <div class="sub">Tattoo and piercing studio</div>
      <p class="lede">Татуировки и проколы в спокойной студии. Эскиз обсуждаем лично, работаем стерильно и без спешки.</p>
      <div class="cta-row">
        <a class="btn solid" href="#book">Записаться</a>
        <a class="btn" href="#works">Смотреть работы</a>
      </div>
    </div>
  </div>

  <div class="marquee" aria-hidden="true"><div class="track">{marquee.map((w) => <span>{w}<i></i></span>)}</div></div>

  <section id="works">
    <div class="wrap">
      <div class="sec-head rv">
        <div><div class="label">Портфолио</div><h2>Работы</h2></div>
        <div class="filters" role="group" aria-label="Фильтр работ">
          <button class="chip" data-f="all" aria-pressed="true">Все</button>
          <button class="chip" data-f="tattoo" aria-pressed="false">Тату</button>
          <button class="chip" data-f="piercing" aria-pressed="false">Пирсинг</button>
        </div>
      </div>
      <div class="grid" id="grid">
        {works.map((w) => (
          <figure class="tile rv" data-c={workCategories(w).join(' ')}>
            <a href={url(`/masters/${w.master.slug}`)} aria-label={`${w.caption ?? 'Работа'} – мастер ${w.master.name}`}>
              <Image src={w.image} alt={w.caption ?? `Работа мастера ${w.master.name}`} widths={[300, 600]} sizes="(max-width: 900px) 50vw, 25vw" />
              <figcaption><b>{w.caption ?? w.master.name}</b><small>{w.caption ? `${w.master.name} →` : 'Портфолио →'}</small></figcaption>
            </a>
          </figure>
        ))}
      </div>
      <div class="more-row"><button class="btn" type="button" id="more" hidden>Показать ещё</button></div>
    </div>
  </section>

  <section class="masters" id="masters">
    <div class="wrap">
      <div class="sec-head rv"><div><div class="label">Команда</div><h2>Мастера</h2></div></div>
      <div class="m-grid">
        {masters.map((m) => (
          <article class="m-card rv">
            <a href={url(`/masters/${m.slug}`)}>
              <div class="m-ph"><Image src={m.photo} alt={`Мастер ${m.name}`} widths={[400, 800]} sizes="(max-width: 800px) 100vw, 33vw" /></div>
              <h3>{m.name}</h3>
              <p>{[directionLabel[m.direction], m.styles.join(', ')].filter(Boolean).join(' · ')}</p>
              <span class="more">Портфолио →</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Teasers />

  <section class="alt" id="prices">
    <div class="wrap">
      <div class="sec-head rv"><div><div class="label">Прайс</div><h2>Цены</h2></div></div>
      <div class="two">
        <div class="rv">
          <h3 class="sub-h">Тату</h3>
          <PriceList only={['tattoo', 'common']} />
          <p class="price-note">Точную стоимость мастер называет после обсуждения эскиза.</p>
        </div>
        <div class="rv">
          <h3 class="sub-h">Пирсинг</h3>
          <PriceList only={['piercing']} />
          <p class="price-note">{piercingPriceNote}</p>
        </div>
      </div>
      <div class="model-cta rv">
        <div>
          <h3 class="sub-h">Стать моделью</h3>
          <p>Ученики студии делают тату и проколы под присмотром мастера – дешевле обычного: {modelPrices}. Свободные места публикуем в канале.</p>
        </div>
        <a class="btn" href={edu.models.channel} target="_blank" rel="noopener">Канал для моделей</a>
      </div>
    </div>
  </section>

  <section id="care">
    <div class="wrap two">
      <div class="rv">
        <div class="label">Заживление</div>
        <h3 class="sub-h">Уход</h3>
        <details open><summary>Свежая татуировка</summary>
          <ul>
            <li>Не чешите свежую татуировку.</li>
            <li>Не пейте алкоголь 3–5 дней.</li>
            <li>Исключите сильные физические нагрузки: походы, тренировки и т. п.</li>
            <li>Не ходите в баню, сауну и хаммам 2 недели.</li>
            <li>Берегите татуировку от прямого солнца до 2 месяцев.</li>
          </ul>
          <p>Заживляют двумя способами: классическим (с пелёнками) или под заживляющей плёнкой. Каждый занимает до 5 дней. Мастер подберёт способ под ваш эскиз и расскажет, как ухаживать.</p>
        </details>
        <details><summary>Свежий прокол</summary><p>Первое время возможен небольшой отёк. Не крутите украшение и не трогайте его грязными руками. После прокола мастер даст рекомендации по уходу и подскажет средства для заживления. Не забудьте записаться на даунсайз – замену штанги на более короткую – не раньше чем через месяц после прокола.</p></details>
        <details><summary>Когда писать мастеру</summary><p>Если отёк держится дольше 2 недель или он слишком сильный – напишите в студию или своему мастеру. Срочно пишите, если поднялась температура, появились гнойные выделения или украшение начало вдавливаться внутрь прокола.</p></details>
      </div>
      <div class="rv">
        <div class="label">Перед сеансом</div>
        <h3 class="sub-h">Важно знать</h3>
        <details><summary>Противопоказания</summary><p>Хронические и острые заболевания, беременность, приём антибиотиков и гормонов, недавние операции. Полный список – на страницах <a href={url('/tattoo#before')}>тату</a> и <a href={url('/piercing#before')}>пирсинга</a>. Об аллергии на материалы и медикаменты предупредите мастера заранее.</p></details>
        <details><summary>Если вам нет 18</summary><p>Работаем с 16 лет с письменным согласием родителя или опекуна. Родителю приходить не обязательно – мы позвоним ему перед сеансом. <a href={url('/docs/soglasie-do-18.pdf')} download="Согласие до 18 – Калина.pdf">Скачать бланк согласия (PDF)</a>.</p></details>
      </div>
    </div>
  </section>

  <Contact />
</Base>

<script>import '../scripts/home';</script>
