---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
---
<Base title="Пирсинг">
  <section class="stub">
    <div class="wrap">
      <div class="label rv">3D-модель головы</div>
      <h2 class="rv" style="font-size:clamp(2.4rem,7vw,5rem);color:var(--brick)">Пирсинг</h2>
      <p class="rv">Здесь будет 3D-голова, которую можно вращать: нажмите на точку прокола, чтобы узнать о нём подробнее.</p>
      <p class="note">Страница в разработке.</p>
    </div>
  </section>
  <Contact />
</Base>
