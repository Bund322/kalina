---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import PiercingHead from '../components/PiercingHead.astro';
import PiercingPopup from '../components/PiercingPopup.astro';
import BodyPiercings from '../components/BodyPiercings.astro';
import PriceList from '../components/PriceList.astro';
import BeforeSession from '../components/BeforeSession.astro';
import { piercingPriceNote } from '../data/studio';
---
<Base title="Пирсинг" description="Интерактивная 3D-модель головы: выберите прокол – ухо, нос, лицо – и узнайте о нём подробнее.">
  <section class="pc">
    <div class="wrap">
      <div class="sec-head rv">
        <div><div class="label">3D-модель головы</div><h2>Пирсинг</h2></div>
        <p class="pc-lede">Покрутите голову и нажмите на точку – расскажем, что это за прокол.</p>
      </div>
      <PiercingHead />
    </div>
  </section>

  <section class="pc-body">
    <div class="wrap">
      <div class="sec-head rv"><div><div class="label">Не только лицо</div><h2>Проколы на теле</h2></div></div>
      <BodyPiercings />
    </div>
  </section>

  <BeforeSession kind="piercing" />

  <section id="prices">
    <div class="wrap two">
      <div class="rv">
        <div class="label">Прайс</div>
        <h3 class="sub-h">Цены</h3>
        <PriceList only={['piercing', 'common']} />
        <p class="price-note">{piercingPriceNote}</p>
      </div>
      <div class="rv" id="care">
        <div class="label">Заживление</div>
        <h3 class="sub-h">Уход за проколом</h3>
        <details open><summary>Первые недели</summary><p>Промывайте прокол физраствором дважды в день и промакивайте чистой салфеткой. Не крутите украшение и не трогайте его грязными руками.</p></details>
        <details><summary>Чего избегать</summary><p>Бассейн, баня, открытые водоёмы и сон на свежем проколе в первые недели. Косметику и спреи держите подальше от места прокола.</p></details>
        <details><summary>Проколы во рту</summary><p>После еды полощите рот водой или безспиртовым ополаскивателем. Первые дни – без острого, горячего и алкоголя.</p></details>
        <details><summary>Смена украшения</summary><p>Не меняйте украшение до конца заживления. Первую замену лучше сделать у мастера – подберём размер и поставим без травмы.</p></details>
        <details><summary>Когда писать мастеру</summary><p>Покраснение растёт, появилась температура или гнойное отделяемое. Лучше написать сразу, чем ждать.</p></details>
      </div>
    </div>
  </section>

  <Contact />
  <PiercingPopup />
</Base>
