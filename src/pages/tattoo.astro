---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
---
<Base title="Тату">
  <section class="stub">
    <div class="wrap">
      <div class="label rv">Карта боли</div>
      <h2 class="rv" style="font-size:clamp(2.4rem,7vw,5rem);color:var(--brick)">Тату</h2>
      <p class="rv">Здесь будет 3D-манекен с зонами тела: нажмите на зону, чтобы узнать, насколько больно делать там татуировку.</p>
      <p class="note">Страница в разработке.</p>
    </div>
  </section>
  <Contact />
</Base>
