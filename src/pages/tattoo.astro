---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import TattooBody from '../components/TattooBody.astro';
import TattooPopup from '../components/TattooPopup.astro';
import PriceList from '../components/PriceList.astro';
import BeforeSession from '../components/BeforeSession.astro';
---
<Base title="Тату" description="Интерактивная карта боли: выберите зону на 3D-модели и узнайте, насколько больно делать там татуировку.">
  <section class="pc">
    <div class="wrap">
      <div class="sec-head rv">
        <div><div class="label">Карта боли</div><h2>Тату</h2></div>
        <p class="pc-lede">Покрутите модель и нажмите на зону – расскажем, насколько там больно и как подготовиться.</p>
      </div>
      <TattooBody />
    </div>
  </section>

  <BeforeSession kind="tattoo" />

  <section id="prices">
    <div class="wrap two">
      <div class="rv">
        <div class="label">Прайс</div>
        <h3 class="sub-h">Цены</h3>
        <PriceList only={['tattoo', 'common']} />
        <p class="note">Точную стоимость мастер называет после обсуждения эскиза.</p>
      </div>
      <div class="rv" id="care">
        <div class="label">Заживление</div>
        <h3 class="sub-h">Уход за тату</h3>
        <details open><summary>Свежая татуировка</summary><p>Снимите плёнку через 2–4 часа или как скажет мастер. Мойте тёплой водой с мягким мылом, промакивайте чистой салфеткой. Наносите тонкий слой крема 2–3 раза в день.</p></details>
        <details><summary>Первые две недели</summary><p>Не паритесь в бане, не купайтесь в бассейне и водоёмах, не загорайте. Корочки не отдирайте, зуд снимайте лёгким похлопыванием.</p></details>
        <details><summary>Солнце</summary><p>После заживления защищайте татуировку кремом с SPF 50 – так цвет и линии дольше остаются чёткими.</p></details>
        <details><summary>Когда писать мастеру</summary><p>Покраснение растёт, появилась температура или гнойное отделяемое. Лучше написать сразу, чем ждать.</p></details>
      </div>
    </div>
  </section>

  <Contact />
  <TattooPopup />
</Base>
